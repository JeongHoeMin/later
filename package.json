{
  "name": "later",
  "version": "1.0.0",
  "description": "나중에",
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:android": "pnpm --filter mobile dev:android",
    "dev:ios": "pnpm --filter mobile dev:ios",
    "open:emulator": "\"%LOCALAPPDATA%\\Android\\Sdk\\emulator\\emulator.exe\" -avd Pixel_4a",
    "prebuild:android": "pnpm --filter mobile prebuild:android",
    "prebuild:ios": "pnpm --filter mobile prebuild:ios",
    "build:api": "pnpm --filter api build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
