# Existing PostgreSQL database for development.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/later_dev

# Google OAuth Web Client ID used as the ID token audience.
# Configure the app to request ID tokens for this same Client ID.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Numeric Kakao Developers App ID (not a REST API key).
# Must match app_id returned by Kakao's access_token_info endpoint.
KAKAO_APP_ID=YOUR_NUMERIC_APP_ID

# Naver authorization codes are exchanged on the server. Never ship the secret to mobile.
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
# Registered by the service owner. Server-side login Callback, not unlink Callback.
NAVER_LOGIN_CALLBACK_URL=https://later.hoe.pe.kr/auth/social/naver/callback
# Required: actual mobile app return URI. Example only: later://auth/naver
# Must match the mobile app configuration; never supplied by request parameters.
NAVER_LOGIN_APP_RETURN_URL=
# Separate random 32-byte AES-GCM key encoded as canonical base64url (43 chars).
# Generate with the command shown for ACCESS_TOKEN_SECRET; do not reuse that secret.
NAVER_LOGIN_BRIDGE_KEY=

# Explicit Apple ID token audiences: iOS Bundle ID and/or web/Android Services ID.
# Comma-separated without spaces. Only register IDs used by this service.
APPLE_CLIENT_IDS=com.example.later,com.example.later.web

# Generate a random secret with at least 32 bytes before enabling AccessTokenModule.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_SECRET=

# Comma-separated trusted proxy IP/CIDR allowlist. Empty means no proxy trust.
# Set only addresses controlled by your deployment; never use true or 0.0.0.0/0.
# IPv6 ranges covering all mapped IPv4 (e.g. ::ffff:0:0/96 or ::/80) are rejected.
TRUSTED_PROXY_CIDRS=

# Required shared Redis for authentication rate limits. Dev: docker compose up -d redis.
# Production: private Redis, ACL/authentication and rediss:// TLS. Never commit credentials.
REDIS_URL=redis://127.0.0.1:6379/0

# Max simultaneous verifications per provider per API process. Default10, integer1..100.
AUTH_PROVIDER_MAX_CONCURRENCY=10
