# Existing PostgreSQL database for development.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/later_dev

# Google OAuth Web Client ID used as the ID token audience.
# Configure the app to request ID tokens for this same Client ID.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Numeric Kakao Developers App ID (not a REST API key).
# Must match app_id returned by Kakao's access_token_info endpoint.
KAKAO_APP_ID=YOUR_NUMERIC_APP_ID

# Naver authorization codes are exchanged on the server. Never ship the secret to mobile.
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# Explicit Apple ID token audiences: iOS Bundle ID and/or web/Android Services ID.
# Comma-separated without spaces. Only register IDs used by this service.
APPLE_CLIENT_IDS=com.example.later,com.example.later.web

# Generate a random secret with at least 32 bytes before enabling AccessTokenModule.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_SECRET=
