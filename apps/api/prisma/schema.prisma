// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum SocialProvider {
  google
  kakao
  naver
  apple
}

model AppleLoginAttempt {
  ownerUserId String?   @db.Uuid
  owner       User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  id          String    @id @db.Uuid
  nonceHash   String    @db.Char(64)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@index([ownerUserId])
}

model NaverLoginAttempt {
  ownerUserId String?   @db.Uuid
  owner       User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  id          String    @id @db.Uuid
  stateHash   String    @unique @db.Char(64)
  secretHash  String    @db.Char(64)
  expiresAt   DateTime
  sealedGrant String?
  callbackAt  DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@index([ownerUserId])
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  socialAccounts    SocialAccount[]
  authSessions      AuthSession[]
  appleLinkAttempts AppleLoginAttempt[]
  naverLinkAttempts NaverLoginAttempt[]
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt, id])
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  hash      String      @unique @db.Char(64)
  sessionId String      @db.Uuid
  usedAt    DateTime?
  createdAt DateTime    @default(now())
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model SocialAccount {
  id        String         @id @default(uuid()) @db.Uuid
  provider  SocialProvider
  subject   String
  userId    String         @db.Uuid
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

model AuthRateLimitBucket {
  key       String   @id @db.Char(64)
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}
