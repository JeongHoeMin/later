# 모바일 앱 환경변수. 이 파일을 .env.local로 복사해 값을 채운다(.env.local은 커밋하지 않는다).
#   cp .env.example .env.local
# EXPO_PUBLIC_* 값은 앱 번들에 그대로 포함된다. 비밀값(Client Secret 등)을 넣지 않는다.
# 소셜 키를 바꾼 뒤에는 prebuild/네이티브 빌드를 다시 한다(pnpm dev:android, pnpm dev:ios).

# [필수] Later API 주소. 에뮬레이터·같은 와이파이 실기기에서 접근 가능한 PC IP를 쓴다.
# 개발 빌드만 http를 허용한다. 출시 빌드는 https 주소가 필요하다.
EXPO_PUBLIC_API_BASE_URL=http://19.19.20.49:3000

# [필수] 카카오 로그인
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > 네이티브 앱 키 (REST API 키 아님)
# 서버 KAKAO_APP_ID(숫자 앱 ID)와 같은 앱이어야 한다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# [필수] Google 로그인 - 웹 클라이언트 ID
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션)
# 서버 GOOGLE_CLIENT_ID와 같은 값이어야 한다(서버가 ID Token audience로 검증).
# Android는 패키지명 kr.pe.hoe.later + SHA-1로 Android 클라이언트를 별도 등록만 하면 되고 여기에 넣지 않는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# [iOS 필수] Google 로그인 - iOS 클라이언트 ID (같은 콘솔의 iOS 유형, 번들 ID kr.pe.hoe.later)
# Android만 빌드하면 비워 둬도 된다.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 앱에 넣지 않는 값
# - 네이버: 서버 브리지(POST /auth/social/naver/start)로 로그인한다. Client ID/Secret은
#   서버 apps/api/.env의 NAVER_CLIENT_ID, NAVER_CLIENT_SECRET에 넣는다.
# - Apple: 환경변수 없음. iOS 번들 ID(app.json)와 서버 APPLE_CLIENT_IDS를 맞춘다.
